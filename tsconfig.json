{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "jsx": "react-jsx"
  },
  "include": [
    "core",
    "integrations",
    "bot",
    "renderers",
    ".claude/skills",
    "tests",
    "remotion.config.ts"
  ]
}
