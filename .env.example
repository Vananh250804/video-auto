# Sao chép file này thành .env rồi điền giá trị. Không commit file .env.

# Đường dẫn FFmpeg (bỏ trống nếu ffmpeg/ffprobe đã có trong PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Đường dẫn lệnh claude (bỏ trống nếu đã có trong PATH)
CLAUDE_PATH=

# Telegram bot (bước 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Google Drive (bước 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_INPUT_FOLDER_ID=
GOOGLE_DRIVE_OUTPUT_FOLDER_ID=

# Giọng đọc AI (bước 2), chỉ cần key của provider bạn dùng
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VBEE_API_KEY=
SAYDI_API_KEY=
